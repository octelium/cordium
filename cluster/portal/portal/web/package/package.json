{
  "name": "a01",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite --host 0.0.0.0",
    "build": "tsc && vite build",
    "lint": "eslint . --ext ts,tsx --report-unused-disable-directives --max-warnings 0",
    "preview": "vite preview",
    "build-dev": "tsc && vite build --mode development",
    "build-staging": "tsc && vite build --mode staging",
    "protoc-gen-workspace": "npx protoc --ts_out ./tmp --ts_opt long_type_number --proto_path ../../../../../ apis/protobuf/main/cordiumv1/cordiumv1.proto",
    "protoc-gen-user": "npx protoc --ts_out ./tmp --ts_opt long_type_number --proto_path ../../../../../ apis/protobuf/main/userv1/userv1.proto",
    "protoc-gen-meta": "npx protoc --ts_out ./tmp --ts_opt long_type_number --proto_path ../../../../../ apis/protobuf/main/metav1/metav1.proto",
    "protoc-gen": "mkdir -p ./tmp/apis/protobuf && npm run protoc-gen-meta && npm run protoc-gen-user && npm run protoc-gen-workspace",
    "protoc-cp": "cp -r ./tmp/apis/protobuf/main/metav1 ./src/apis && cp -r ./tmp/apis/protobuf/main/cordiumv1 ./src/apis && cp -r ./tmp/apis/protobuf/main/userv1 ./src/apis",
    "protoc-fix": "find ./src/apis -name '*.ts' -exec sed -i s#../../../../google/protobuf#../google/protobuf#g {} +",
    "protoc": "npm run protoc-gen && npm run protoc-cp && npm run protoc-fix"
  },
  "dependencies": {
    "@headlessui/react": "^2.2.10",
    "@mantine/core": "^9.1.0",
    "@mantine/hooks": "^9.1.0",
    "@protobuf-ts/grpcweb-transport": "^2.11.1",
    "@protobuf-ts/plugin": "^2.11.1",
    "@reduxjs/toolkit": "^2.11.2",
    "@sindresorhus/slugify": "^3.0.0",
    "@tabler/icons-react": "^3.41.1",
    "@tanstack/react-query": "^5.100.1",
    "@uiw/codemirror-extensions-langs": "^4.25.9",
    "@uiw/react-codemirror": "^4.25.9",
    "@xterm/addon-fit": "^0.11.0",
    "@xterm/addon-serialize": "^0.14.0",
    "@xterm/addon-web-links": "^0.12.0",
    "@xterm/addon-webgl": "^0.19.0",
    "@xterm/xterm": "^6.0.0",
    "axios": "^1.15.2",
    "chance": "^1.1.13",
    "dayjs": "^1.11.20",
    "framer-motion": "^12.38.0",
    "js-yaml": "^4.1.1",
    "lodash": "^4.18.1",
    "lucide-react": "^1.8.0",
    "nanoevents": "^9.1.0",
    "react": "^19.2.5",
    "react-dom": "^19.2.5",
    "react-hot-toast": "^2.6.0",
    "react-icons": "^5.6.0",
    "react-redux": "^9.2.0",
    "react-router-dom": "^7.14.2",
    "react-spinners": "^0.17.0",
    "reconnecting-websocket": "^4.4.0",
    "redux-thunk": "^3.1.0",
    "tailwind-merge": "^3.5.0",
    "truncate": "^3.0.0",
    "truncate-utf8-bytes": "^1.0.2",
    "ts-pattern": "^5.9.0",
    "uuid": "^14.0.0",
    "uuidv4": "^6.2.13",
    "vite-plugin-http2": "^1.0.15",
    "vite-plugin-svgr": "^5.2.0"
  },
  "devDependencies": {
    "@rollup/plugin-commonjs": "^29.0.2",
    "@tailwindcss/postcss": "^4.2.4",
    "@types/chance": "^1.1.7",
    "@types/js-yaml": "^4.0.9",
    "@types/lodash": "^4.17.24",
    "@types/node": "^25.6.0",
    "@types/react": "^19.2.14",
    "@types/react-copy-to-clipboard": "^5.0.7",
    "@types/react-dom": "^19.2.3",
    "@types/truncate-utf8-bytes": "^1.0.2",
    "@types/uuid": "^11.0.0",
    "@typescript-eslint/eslint-plugin": "^8.59.0",
    "@typescript-eslint/parser": "^8.59.0",
    "@vitejs/plugin-react-swc": "^4.3.0",
    "autoprefixer": "^10.5.0",
    "eslint": "^10.2.1",
    "eslint-plugin-react-hooks": "^7.1.1",
    "eslint-plugin-react-refresh": "^0.5.2",
    "postcss": "^8.5.10",
    "postcss-preset-mantine": "^1.18.0",
    "postcss-simple-vars": "^7.0.1",
    "rollup-plugin-visualizer": "^7.0.1",
    "sass": "^1.99.0",
    "tailwindcss": "^4.2.4",
    "typescript": "^6.0.3",
    "vite": "^8.0.10"
  }
}
