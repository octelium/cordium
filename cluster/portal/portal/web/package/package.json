{
  "name": "a01",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite --host 0.0.0.0",
    "build": "tsc && vite build",
    "lint": "eslint . --ext ts,tsx --report-unused-disable-directives --max-warnings 0",
    "preview": "vite preview",
    "build-dev": "tsc && vite build --mode development",
    "build-staging": "tsc && vite build --mode staging",
    "protoc-gen-workspace": "npx protoc --ts_out ./tmp --ts_opt long_type_number --proto_path ../../../../../ apis/protobuf/main/cordiumv1/cordiumv1.proto",
    "protoc-gen-user": "npx protoc --ts_out ./tmp --ts_opt long_type_number --proto_path ../../../../../ apis/protobuf/main/userv1/userv1.proto",
    "protoc-gen-meta": "npx protoc --ts_out ./tmp --ts_opt long_type_number --proto_path ../../../../../ apis/protobuf/main/metav1/metav1.proto",
    "protoc-gen": "mkdir -p ./tmp/apis/protobuf && npm run protoc-gen-meta && npm run protoc-gen-user && npm run protoc-gen-workspace",
    "protoc-cp": "cp -r ./tmp/apis/protobuf/main/metav1 ./src/apis && cp -r ./tmp/apis/protobuf/main/cordiumv1 ./src/apis && cp -r ./tmp/apis/protobuf/main/userv1 ./src/apis",
    "protoc-fix": "find ./src/apis -name '*.ts' -exec sed -i s#../../../../google/protobuf#../google/protobuf#g {} +",
    "protoc": "npm run protoc-gen && npm run protoc-cp && npm run protoc-fix"
  },
  "dependencies": {
    "@fontsource/ubuntu": "^5.3.0",
    "@headlessui/react": "^2.2.10",
    "@mantine/core": "^9.5.2",
    "@mantine/hooks": "^9.5.2",
    "@octelium/apis": "^1.0.7",
    "@protobuf-ts/grpcweb-transport": "^2.11.1",
    "@protobuf-ts/plugin": "^2.11.1",
    "@reduxjs/toolkit": "^2.12.0",
    "@sindresorhus/slugify": "^3.0.0",
    "@tabler/icons-react": "^3.46.0",
    "@tanstack/react-query": "^5.102.8",
    "@uiw/codemirror-extensions-langs": "^4.25.11",
    "@uiw/react-codemirror": "^4.25.11",
    "@xterm/addon-fit": "^0.11.0",
    "@xterm/addon-serialize": "^0.14.0",
    "@xterm/addon-web-links": "^0.12.0",
    "@xterm/addon-webgl": "^0.19.0",
    "@xterm/xterm": "^6.0.0",
    "axios": "^1.20.0",
    "chance": "^1.1.13",
    "dayjs": "^1.11.23",
    "framer-motion": "^13.1.1",
    "js-yaml": "^5.4.1",
    "lodash": "^4.18.1",
    "lucide-react": "^1.35.0",
    "nanoevents": "^10.0.0",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "react-hot-toast": "^2.6.0",
    "react-icons": "^5.7.0",
    "react-redux": "^9.3.0",
    "react-router-dom": "^7.18.3",
    "react-spinners": "^0.17.0",
    "reconnecting-websocket": "^4.4.0",
    "redux-thunk": "^3.1.0",
    "tailwind-merge": "^3.6.0",
    "truncate": "^3.0.0",
    "truncate-utf8-bytes": "^1.0.2",
    "ts-pattern": "^5.9.0",
    "uuid": "^14.0.2",
    "vite-plugin-svgr": "^5.2.0"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@rollup/plugin-commonjs": "^29.0.3",
    "@tailwindcss/postcss": "^4.3.3",
    "@types/chance": "^1.1.8",
    "@types/lodash": "^4.17.25",
    "@types/node": "^26.4.0",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.5",
    "@types/truncate-utf8-bytes": "^1.0.2",
    "@typescript-eslint/eslint-plugin": "^8.68.0",
    "@typescript-eslint/parser": "^8.68.0",
    "@vitejs/plugin-react-swc": "^4.3.3",
    "autoprefixer": "^10.5.4",
    "eslint": "^10.9.1",
    "eslint-plugin-react-hooks": "^7.1.1",
    "eslint-plugin-react-refresh": "^0.5.5",
    "globals": "^17.11.0",
    "postcss": "^8.5.26",
    "postcss-preset-mantine": "^1.18.0",
    "postcss-simple-vars": "^7.0.1",
    "rollup-plugin-visualizer": "^7.1.1",
    "sass": "^1.103.1",
    "tailwindcss": "^4.3.3",
    "typescript": "^6.0.3",
    "vite": "^8.2.2"
  }
}
